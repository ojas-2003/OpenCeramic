{
  "name": "openceramic",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "fiber:types": "openapi-typescript https://api.fiber.ai/openapi.json -o src/fiber/types.generated.d.ts",
    "inngest:dev": "docker compose up inngest",
    "inngest:down": "docker compose down"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fiberai/sdk": "^0.0.51",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.20.0",
    "lucide-react": "^1.41.0",
    "next": "15.5.25",
    "papaparse": "^5.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
