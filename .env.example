DATABASE_URL=
FIBER_API_KEY=
FIBER_BASE_URL=https://api.fiber.ai
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local dev only: tells the Inngest SDK to talk to the local dev server
# instead of Inngest Cloud. Leave unset in production.
INNGEST_DEV=1
MAX_CREDITS_PER_RUN=2000
# Cap on what one unattended poll may spend enriching the rows it just found.
# Deliberately far below MAX_CREDITS_PER_RUN: nobody saw this estimate.
MAX_AUTO_CREDITS_PER_POLL=200
CACHE_TTL_SECONDS=604800

# Serve Fiber responses from recorded fixtures instead of the live API.
# Required for the demo today: sandbox keys return 501 for 4 of the 6
# operations this project uses. Set to 0 with a live sk_live_ key.
FIBER_FAKE=1
